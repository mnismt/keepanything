# Copy to .env (gitignored). The app also accepts the key via Settings (stored encrypted with safeStorage).
KEEPANYTHING_GMI_API_KEY=
KEEPANYTHING_GMI_BASE_URL=https://api.gmi-serving.com/v1
KEEPANYTHING_MODEL=MiniMaxAI/MiniMax-M3
# KEEPANYTHING_AI=gmi|mock|off   (default: gmi when a key is present, otherwise mock)
