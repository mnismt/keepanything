# Copy to .env (gitignored). The app also accepts keys via Settings (stored encrypted with safeStorage).

# GMI Cloud (default provider when a key is present).
KEEPANYTHING_GMI_API_KEY=
KEEPANYTHING_GMI_BASE_URL=https://api.gmi-serving.com/v1
KEEPANYTHING_MODEL=MiniMaxAI/MiniMax-M3

# OpenRouter.
KEEPANYTHING_OPENROUTER_API_KEY=
KEEPANYTHING_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KEEPANYTHING_OPENROUTER_MODEL=minimax/minimax-m3:free

# KEEPANYTHING_AI=gmi|openrouter|mock|off (default: gmi with a key, otherwise off; mock is opt-in)